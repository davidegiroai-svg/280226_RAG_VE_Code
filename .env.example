# RAG VE - Database Configuration
# Copiare questo file in .env e compilare con valori sicuri

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_password_change_me
POSTGRES_DB=rag
POSTGRES_PORT=5432

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_TIMEOUT_S=30

INBOX_ROOT=/data/inbox
MAX_UPLOAD_SIZE_MB=50

OLLAMA_LLM_MODEL=llama3.2
LLM_TIMEOUT_S=30

# Autenticazione API key (true/false)
# Impostare false solo in sviluppo locale, mai in produzione
AUTH_ENABLED=true

# Frontend Web (M3)
FRONTEND_PORT=3000
# Creare con: .\scripts\bootstrap_auth.ps1
FRONTEND_API_KEY=your_api_key_here

# Sicurezza avanzata (preparazione futura — non usato nell'implementazione corrente)
# Da valorizzare prima di abilitare JWT/RBAC
SECRET_KEY=change_me_in_production
